name: Build Android App Bundle (Play Store)

on:
  push:
    branches: [ master, main ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      with:
        fetch-depth: 1

    - name: Setup Java
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'zulu'
        cache: 'gradle'

    - name: Setup Flutter
      uses: subosito/flutter-action@v2
      with:
        flutter-version: '3.41.9'
        channel: 'stable'

    - name: Cache Flutter dependencies
      uses: actions/cache@v4
      with:
        path: |
          ~/.pub-cache
          ~/.gradle/caches
        key: flutter-deps-${{ runner.os }}-${{ hashFiles('**/pubspec.lock') }}
        restore-keys: |
          flutter-deps-${{ runner.os }}-

    - name: Auto-increment version code
      run: |
        # Extract current version from pubspec.yaml
        CURRENT_VERSION=$(grep "^version:" pubspec.yaml | sed 's/version: //')
        echo "Current version: $CURRENT_VERSION"
        
        # Split into version name and code
        VERSION_NAME=$(echo $CURRENT_VERSION | cut -d'+' -f1)
        VERSION_CODE=$(echo $CURRENT_VERSION | cut -d'+' -f2)
        
        # Increment version code
        NEW_VERSION_CODE=$((VERSION_CODE + 1))
        NEW_VERSION="${VERSION_NAME}+${NEW_VERSION_CODE}"
        
        echo "New version: $NEW_VERSION"
        
        # Update pubspec.yaml
        sed -i "s/^version: .*/version: ${NEW_VERSION}/" pubspec.yaml
        
        # Show result
        grep "^version:" pubspec.yaml

    - name: Commit version bump
      run: |
        git config --local user.email "action@github.com"
        git config --local user.name "GitHub Action"
        git add pubspec.yaml
        git diff --cached --quiet || git commit -m "Auto-increment version code to +${NEW_VERSION_CODE}"
        
    - name: Push version bump
      uses: ad-m/github-push-action@master
      with:
        github_token: ${{ secrets.GITHUB_TOKEN }}
        branch: ${{ github.ref }}

    - name: Clean Flutter build
      run: |
        flutter clean
        rm -rf build/ .dart_tool/ .flutter-plugins*

    - name: Get dependencies
      run: |
        flutter pub get
        flutter pub upgrade

    - name: Setup signing config
      env:
        KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
        KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
        KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
        KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
      run: |
        echo "$KEYSTORE_BASE64" | base64 -d > android/app/release-keystore.jks
        echo "storePassword=$KEYSTORE_PASSWORD" > android/key.properties
        echo "keyPassword=$KEY_PASSWORD" >> android/key.properties
        echo "keyAlias=$KEY_ALIAS" >> android/key.properties
        echo "storeFile=release-keystore.jks" >> android/key.properties
        echo "=== key.properties ==="
        cat android/key.properties
        echo "=== Keystore SHA1 ==="
        keytool -list -v -keystore android/app/release-keystore.jks -storepass "$KEYSTORE_PASSWORD" 2>&1 | grep -E "SHA1|Alias|Owner"
        echo "=== key.properties exists check ==="
        ls -la android/key.properties android/app/release-keystore.jks

    - name: Build App Bundle
      run: |
        flutter build appbundle --release

    - name: Upload AAB
      uses: actions/upload-artifact@v4
      with:
        name: ritme-aab-signed
        path: build/app/outputs/bundle/release/app-release.aab
        retention-days: 7

    # === PLAY STORE DEPLOY (optional — only if key exists) ===
    - name: Setup Play Store key
      id: playstore
      env:
        PLAYSTORE_DEPLOY_KEY: ${{ secrets.PLAYSTORE_DEPLOY_KEY }}
      run: |
        if [ -n "$PLAYSTORE_DEPLOY_KEY" ]; then
          echo "$PLAYSTORE_DEPLOY_KEY" | base64 -d > android/keys.json
          echo "has_key=true" >> $GITHUB_OUTPUT
        else
          echo "has_key=false" >> $GITHUB_OUTPUT
        fi

    - name: Setup Ruby & Fastlane
      if: steps.playstore.outputs.has_key == 'true'
      uses: ruby/setup-ruby@v1
      with:
        ruby-version: '3.3'
        bundler-cache: true

    - name: Deploy to Play Store
      if: steps.playstore.outputs.has_key == 'true'
      working-directory: android
      run: bundle exec fastlane deploy_internal_test

    - name: Create Release
      if: github.ref == 'refs/heads/main'
      uses: softprops/action-gh-release@v2
      with:
        files: build/app/outputs/bundle/release/app-release.aab
        tag_name: playstore-v${{ github.run_number }}
        name: Play Store Release v${{ github.run_number }}
        body: |
          Play Store App Bundle (AAB) voor Ritme
          
          ## Upload naar Play Store
          1. Download `app-release.aab`
          2. Ga naar https://play.google.com/console
          3. Upload de AAB bij "App bundles"
      env:
        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}