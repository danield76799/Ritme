name: Build Android APK (Ritme)

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    
    - name: Setup Flutter 3.24.5
      uses: subosito/flutter-action@v2
      with:
        flutter-version: '3.24.5'
        channel: 'stable'
    
    - name: Setup Java 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'
    
    - name: Flutter Info
      run: |
        flutter --version
        flutter doctor -v
    
    - name: Get Dependencies
      run: flutter pub get
    
    - name: Build APK (with fallback)
      run: |
        # Try build, capture ALL output
        flutter build apk --release 2>&1 | tee build_output.log || true
        
        # Check if APK was created despite any errors
        echo "=== Checking for APK ==="
        find build -name "*.apk" -type f 2>/dev/null
        
        # If APK exists, we're good
        if [ -f "build/app/outputs/flutter-apk/app-release.apk" ]; then
          echo "✅ APK found at flutter-apk/app-release.apk"
          cp build/app/outputs/flutter-apk/app-release.apk app-release.apk
          exit 0
        fi
        
        if [ -f "build/app/outputs/apk/release/app-release.apk" ]; then
          echo "✅ APK found at apk/release/app-release.apk"
          cp build/app/outputs/apk/release/app-release.apk app-release.apk
          exit 0
        fi
        
        # No APK - show error and fail
        echo "❌ No APK found. Build output:"
        cat build_output.log
        exit 1
    
    - name: Upload APK
      uses: actions/upload-artifact@v4
      if: always()
      with:
        name: ritme-apk
        path: app-release.apk
        if-no-files-found: ignore
    
    - name: Create Release
      if: github.ref == 'refs/heads/main' && always()
      uses: softprops/action-gh-release@v1
      with:
        tag_name: v1.3.4-build${{ github.run_number }}
        name: Ritme v1.3.4 (Build ${{ github.run_number }})
        files: app-release.apk
        body: |
          ## Ritme v1.3.4 Build ${{ github.run_number }}
          
          **Build:** ${{ github.run_number }}  
          **Commit:** ${{ github.sha }}
          
          **Wijzigingen:**
          - Workflow verbeterd voor betrouwbaardere builds
          - Flutter 3.24.5 gebruikt
          
          **Let op:** Automatische build.
      env:
        GITHUB_TOKEN: *** secrets.GITHUB_TOKEN }}