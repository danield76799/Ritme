<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ritme Check-in"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <ImageButton
            android:id="@+id/btn_mood_bad"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_mood_bad"
            android:contentDescription="Slecht" />

        <ImageButton
            android:id="@+id/btn_mood_ok"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_mood_ok"
            android:contentDescription="OK" />

        <ImageButton
            android:id="@+id/btn_mood_good"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_mood_good"
            android:contentDescription="Goed" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_open_app"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Open app"
        android:textSize="12sp"
        android:background="@drawable/widget_button_bg"
        android:textColor="#FFFFFF" />

</LinearLayout>
